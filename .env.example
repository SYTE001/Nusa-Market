# Supabase public credentials — safe to expose to the browser.
# Copy this file to `.env.local` and fill in your project's values, then restart
# the dev server. When both are absent the storefront still builds and runs;
# the auth pages show an honest "not configured" notice instead of failing.
#
# Find these in your Supabase dashboard:
#   Project Settings → API → Project URL
#   Project Settings → API → Project API keys → anon / public
#
# Only the anon/publishable key belongs here. The service-role key grants
# full database access and must NEVER be bundled into the client — it belongs
# on a server you control.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
